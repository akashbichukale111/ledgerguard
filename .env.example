# ---------------------------------------------------------------------------
# LedgerGuard — local environment template
#
# Copy to .env and adjust. .env is gitignored and MUST NEVER be committed.
#   cp .env.example .env
#
# Every value here is a PLACEHOLDER for local development only. These
# credentials are deliberately weak and obviously non-production; they exist so
# the local stack boots, not to be secure. A real deployment sources every one
# of these from a secret manager.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=ledgerguard

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=ledgerguard
POSTGRES_SUPERUSER_PASSWORD=change_me_local_only

# Databases created by infra/postgres/init/01-databases.sql
POSTGRES_TXN_DB=ledgerguard_txn
POSTGRES_RECON_DB=ledgerguard_recon
POSTGRES_AUDIT_DB=ledgerguard_audit

# Least-privilege application role. Deliberately NOT the superuser: the audit
# migration REVOKEs UPDATE/DELETE from this role, which only means something if
# services actually connect as it. See ADR-0014.
POSTGRES_APP_USER=lg_app
POSTGRES_APP_PASSWORD=change_me_local_only

# --- MongoDB ---------------------------------------------------------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=ledgerguard
MONGO_INITDB_ROOT_PASSWORD=change_me_local_only
MONGO_DB=ledgerguard_read

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_local_only

# --- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Local only: single broker, KRaft, no ZooKeeper. Production needs RF>=3 and
# min.insync.replicas=2 — see docs/operations.md.
KAFKA_REPLICATION_FACTOR=1
KAFKA_PARTITIONS=3

# --- Observability ---------------------------------------------------------
ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
TRACING_SAMPLE_PROBABILITY=1.0

# --- Security --------------------------------------------------------------
AUTH_ISSUER_URI=http://auth-server:9000
AUTH_JWK_SET_URI=http://auth-server:9000/oauth2/jwks

# --- Application -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
