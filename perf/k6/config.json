{
  "baseUrl": "http://localhost:8080/api/v1",
  "authToken": "test-jwt-token",
  "performance_baselines": {
    "transaction_ingest": {
      "target_rps": 1000,
      "p95_latency_ms": 500,
      "p99_latency_ms": 1000,
      "max_error_rate": 0.01
    },
    "reconciliation_query": {
      "target_rps": 500,
      "p95_latency_ms": 1000,
      "p99_latency_ms": 2000,
      "max_error_rate": 0.01
    },
    "projection_lag": {
      "target_rps": 200,
      "p95_latency_ms": 200,
      "p99_latency_ms": 500,
      "max_error_rate": 0.01,
      "max_lag_ms": 5000
    },
    "e2e_flow": {
      "target_rps": 100,
      "p95_latency_ms": 2000,
      "p99_latency_ms": 5000,
      "max_error_rate": 0.01
    }
  },
  "load_profiles": {
    "steady_state": {
      "vus": 50,
      "duration": "5m",
      "description": "Steady-state load at 50 concurrent users"
    },
    "ramp": {
      "stages": [
        { "duration": "2m", "target": 50 },
        { "duration": "5m", "target": 200 },
        { "duration": "2m", "target": 50 },
        { "duration": "1m", "target": 0 }
      ],
      "description": "Gradual ramp-up and down to test scaling"
    },
    "spike": {
      "stages": [
        { "duration": "2m", "target": 50 },
        { "duration": "2m", "target": 300 },
        { "duration": "3m", "target": 300 },
        { "duration": "2m", "target": 50 },
        { "duration": "1m", "target": 0 }
      ],
      "description": "Sudden spike to 300 VUs to test recovery"
    },
    "soak": {
      "stages": [
        { "duration": "5m", "target": 100 },
        { "duration": "30m", "target": 100 },
        { "duration": "5m", "target": 0 }
      ],
      "description": "Sustained load for 30 minutes to detect memory leaks"
    }
  }
}
